{
  "name": "ai-roleplay",
  "version": "0.1.0",
  "private": true,
  "description": "Local D&D table where Claude is the DM over MCP",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "dm-report": "node --disable-warning=ExperimentalWarning src/dm-report.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "storybook:fixtures": "node --disable-warning=ExperimentalWarning stories/fixtures/generate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/html-vite": "^10.6.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
